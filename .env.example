# Postgres connection string.
# Local dev (matches docker-compose.yaml):
DATABASE_URL=postgresql://airplanes:airplanes@localhost:5432/airplanes_db

# Production (Vercel) sets DATABASE_URL via project env vars and uses
# @neondatabase/serverless. The driver switch is automatic when VERCEL=1.

# better-auth
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here
# The base URL of your app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Cloud Console → OAuth 2.0 Client → Web application).
# Authorized redirect URI must be: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Cron — set as env var in Vercel project settings; Vercel sends it as Authorization header.
CRON_SECRET=

# Vercel Blob — stores profile images. On Vercel, run `vercel env pull` to populate.
# Required for photo uploads on /settings/profile.
BLOB_READ_WRITE_TOKEN=

# Resend (https://resend.com) — sends OTP login codes.
# When unset in dev, the OTP is logged to the server console and no email is sent.
RESEND_API_KEY=
# Verified sender. Use the resend.dev sandbox until your own domain is verified.
EMAIL_FROM="Airplanes <onboarding@resend.dev>"

# OpenSky Network — OAuth2 client credentials.
# Create an API client at https://opensky-network.org/my-opensky/account → API client.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Upstash Redis — shared cache for OpenSky flight data (avoids per-instance rate limiting).
# Local dev (matches docker-compose.yaml — run npm run dev:up first):
KV_REST_API_URL=http://localhost:8079
KV_REST_API_TOKEN=local_token
KV_REST_API_READ_ONLY_TOKEN=local_token
# Production: replace with credentials from https://console.upstash.com → Redis → Create
# KV_REST_API_URL=https://<your-db>.upstash.io
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
# KV_URL=rediss://default:<token>@<your-db>.upstash.io:6379
# REDIS_URL=rediss://default:<token>@<your-db>.upstash.io:6379
