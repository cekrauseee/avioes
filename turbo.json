{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "POSTGRES_URL",
    "POSTGRES_PASSWORD",
    "POSTGRES_URL_NON_POOLING",
    "POSTGRES_PRISMA_URL",
    "POSTGRES_DATABASE",
    "NEON_PROJECT_ID",
    "DATABASE_URL_UNPOOLED",
    "PGPASSWORD",
    "POSTGRES_USER",
    "PGUSER",
    "PGHOST_UNPOOLED",
    "POSTGRES_URL_NO_SSL",
    "POSTGRES_HOST",
    "PGHOST",
    "PGDATABASE",
    "KV_REST_API_READ_ONLY_TOKEN",
    "KV_URL",
    "REDIS_URL",
    "KV_REST_API_URL",
    "KV_REST_API_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "DRIZZLE_DRIVER",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "NEXT_PUBLIC_BETTER_AUTH_URL",
        "COOKIE_DOMAIN",
        "TRUSTED_ORIGINS",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "BLOB_READ_WRITE_TOKEN",
        "CRON_SECRET",
        "VERCEL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "db:generate": { "cache": false },
    "db:push": { "cache": false },
    "db:migrate": { "cache": false },
    "db:studio": { "cache": false, "persistent": true }
  }
}
