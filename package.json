{
  "name": "airplanes",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down -v",
    "db:push": "turbo run db:push --filter=@airplanes/db",
    "db:generate": "turbo run db:generate --filter=@airplanes/db",
    "db:migrate": "turbo run db:migrate --filter=@airplanes/db",
    "db:studio": "turbo run db:studio --filter=@airplanes/db"
  },
  "dependencies": {
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
